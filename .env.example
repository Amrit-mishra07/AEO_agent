# Google Gemini API Key (Required for 6D Content Scoring, Grounding, and Fix Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model identifier (Defaults to gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-flash-latest, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Runtime Environment
NODE_ENV=production
PORT=3000
